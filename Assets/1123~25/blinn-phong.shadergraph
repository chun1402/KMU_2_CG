{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6b3da2acbb684a1f8bcd613ab63606a1",
    "m_Title": "Blinn-Phong",
    "m_Content": "N = Normal Vector\nL = -Main Light Direction\nV = View Direction\nH = normalize(L + V)\nDiffuse = saturate(N·L) * Color\nSpecular = pow(saturate(N·H), Shininess(Float))\nOut = Diffuse + Specular",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -529.3333129882813,
        "y": 218.6666717529297,
